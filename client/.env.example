
# DO NOT EDIT THIS FILE. COPY AND PASTE IT, THEN RENAME THE COPY TO ".env"
# DONT WRITE API KEYS IN ".env.example"

# --- Server URL --- #

# To connect to a locally hosted backend, create the server .env file and uncomment "USE_SQLITE" & "DOMAIN" and add
# <YOUR IP> 
# Then run the backedn and uncomment one of these "EXPO_PUBLIC_SERVER_ENDPOINT=..." options

#EXPO_PUBLIC_SERVER_ENDPOINT=http://10.0.2.2:8000        # andriod emulator + local backend
#EXPO_PUBLIC_SERVER_ENDPOINT=http://127.0.0.1:8000       # web + local backend
#EXPO_PUBLIC_SERVER_ENDPOINT=http://<YOUR IP>:8000       # expo go app + local backend

# INFO FOR RUNNING EXPO GO APP WITH LOCAL BACKEND:

# first make sure you set up the local backend right:
# https://github.com/LeeuwBas/project-software-engineering/wiki/Development-Environment-Setup

# For the expo go app you can see you ip whenever you run expo start, it will say
# Metro waiting on exp://<YOUR IP>:8081  Replace all instances of <YOUR IP> with that ip (something like 192.168.xx.xx)

# You will need to run on your native os (SO NO WSL), with admin, as well as open it to http by adding 0.0.0.0:8000
# On sudo runs with its own source so you may have to target your python virtual enviornment manually.
# (Also if you were using a venv on wsl you cant use the same on on windows, you have to make a new one
# or you can be lazy and install the requirements (pip install -r server/requirements.txt) on you main python install)

# // windows
# sudo .\windows_venv\Scripts\python.exe .\server\src\manage.py runserver 0.0.0.0:8000
# // linux
# sudo .venv/bin/python server/src/manage.py runserver 0.0.0.0:8000


# --- Weather API key --- #
EXPO_PUBLIC_WEATHER_API_KEY= # find one on https://openweathermap.org/api or the #server channel in the discord


# --- Disable auth for testing --- #
#EXPO_PUBLIC_DISABLE_AUTH=True
