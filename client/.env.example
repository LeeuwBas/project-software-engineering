
# DO NOT EDIT THIS FILE. COPY AND PASTE IT, THEN RENAME THE COPY TO ".env"
# DONT WRITE API KEYS IN ".env.example"

# --- Server URL --- #
# EXPO_PUBLIC_SERVER_ENDPOINT=http://10.0.2.2:8000 

# uncomment if you want to host the backend locally, by default it uses the UvA server URL

# http://10.0.2.2:8000 - when using andriod emulator + locally hosted backend
# http://127.0.0.1:8000 - when testing web + locally hosted backend


# --- Weather API key --- #
EXPO_PUBLIC_WEATHER_API_KEY= # find one on open weather map


# --- Disable auth for testing --- #
EXPO_PUBLIC_DISABLE_AUTH=True
